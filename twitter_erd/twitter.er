[users]
  *id {label: "bigint, not null"}
  email {label: "varchar, not null, uniq"}
  password_digest {label: "varchar, not null"}
  username {label: "varchar, null, uniq"}
  display_name {label: "varchar, not null"}
  phone_number {label: "varchar, null, uniq"}
  birthday {label: "date, not null"}
  bio {label: "text, null"}
  web_site {label: "varchar, null"}
  profile_image_url {label: "varchar, null"}
  header_image_url {label: "varchar, null"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

[tweets]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  content {label: "varchar(140), not null"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

[likes]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

[retweets]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

[bookmarks]
  *id {label: "bigint, not null"}
  user_id {label: "bigint, not null, FK(users)"}
  tweet_id {label: "bigint, not null, FK(tweets)"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

[follows]
  *id {label: "bigint, not null"}
  follower_id {label: "bigint, not null, FK(users)"}
  followee_id {label: "bigint, not null, FK(users)"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

[direct_messages]
  *id {label: "bigint, not null"}
  sender_id {label: "bigint, not null, FK(users)"}
  receiver_id {label: "bigint, not null, FK(users)"}
  content {label: "text, not null"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

[notifications]
  *id {label: "bigint, not null"}
  recipient_id {label: "bigint, not null, FK(users)"}
  actor_id {label: "bigint, not null, FK(users)"}
  tweet_id {label: "bigint, null, FK(tweets)"}
  notification_type {label: "varchar, not null"}
  is_read {label: "boolean, not null"}
  created_at {label: "timestamp, not null"}
  updated_at {label: "timestamp, not null"}

users 1--* tweets
users 1--* likes
users 1--* retweets
users 1--* bookmarks
tweets 1--* likes
tweets 1--* retweets
tweets 1--* bookmarks
users 1--* follows {label: "follower_id"}
users 1--* follows {label: "followee_id"}
users 1--* direct_messages {label: "sender_id"}
users 1--* direct_messages {label: "receiver_id"}
users 1--* notifications {label: "recipient_id"}
users 1--* notifications {label: "actor_id"}
tweets ?--* notifications {label: "tweet_id"}